<!doctype html>
<html lang="zh-Hans">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{ section.topic_name }} · {{ site.site_title }}</title>
  <link rel="stylesheet" href="/base.css">
</head>
<body>
  <header>
    <div class="wrap">
      <p class="meta"><a href="/">首页</a> · 发布日期：{{ section.publication_date }}</p>
      <h1 class="brand">{{ section.topic_name }}</h1>
      <p class="tagline">{{ section.overview }}</p>
    </div>
  </header>
  <main class="wrap section-report">
    {% if section.news_items %}
      {% for item in section.news_items %}
      <article class="news-analysis" id="{{ item.id }}">
        <p class="meta">{{ section.topic_name }}</p>
        <h2>{{ loop.index }}. {{ item.title }}</h2>
        {% if item.audio_path %}
        <audio controls preload="none" src="/{{ item.audio_path }}"></audio>
        {% endif %}
        {% if item.cross_section_notice %}
        <aside class="cross-section-note">
          <p>{{ item.cross_section_notice }}</p>
          {% if item.cross_section_links %}
          <ul>
            {% for link in item.cross_section_links %}
            <li><a href="{{ link.href }}">{{ link.topic_name }}：{{ link.title }}</a></li>
            {% endfor %}
          </ul>
          {% endif %}
        </aside>
        {% endif %}
        <div class="article-body">
          {{ item.body_html | safe }}
        </div>
        <section class="impact-block">
          <h3>对我们的影响</h3>
          {{ item.impact_html | safe }}
        </section>
        <section class="citations-block">
          <h3>Citations</h3>
          <ol class="citation-list">
            {% for citation in item.citations %}
            <li><span>[{{ citation.ref }}]</span> <a href="{{ citation.url }}" rel="nofollow noopener noreferrer">{{ citation.title }}</a><small>{{ citation.source_name }}</small></li>
            {% endfor %}
          </ol>
        </section>
      </article>
      {% endfor %}
    {% else %}
      <p class="note">今天这个主题还没有通过事实核查的分析。</p>
    {% endif %}
  </main>
</body>
</html>
