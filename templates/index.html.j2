<!doctype html>
<html lang="zh-Hans">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{ site.site_title }}</title>
  <link rel="stylesheet" href="/base.css">
</head>
<body>
  <header class="home-hero">
    <div class="wrap">
      <p class="meta">发布日期：{{ publication_date }} · 视角：加拿大普通人，温哥华优先</p>
      <h1 class="brand">{{ site.site_title }}</h1>
      <p class="tagline">今天有 {{ total_news }} 条新闻会对我们的生活造成影响。</p>
    </div>
  </header>
  <main class="wrap">
    <section class="topic-grid" aria-label="主题入口">
      {% for section in sections %}
      <a class="card" href="/topics/{{ section.topic }}">
        <span class="section-count">{{ section.news_items | length }}</span>
        <h2>{{ section.topic_name }}</h2>
        <p>{{ section.topic_description }}</p>
        <small>{{ section.overview }}</small>
      </a>
      {% endfor %}
    </section>
  </main>
  <footer>
    <div class="wrap">内容只保留最近 5 天。所有分析必须附真实来源。 · <a href="/privacy">隐私说明</a></div>
  </footer>
</body>
</html>
